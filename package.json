{
  "name": "design-system-doctor",
  "version": "0.1.0",
  "private": true,
  "description": "Figma plugin that audits a page against a configured design system.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.139.0",
    "esbuild": "^0.28.2",
    "preact": "^10.29.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
